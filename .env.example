# ==========================================================================
# WebCreoling / The Daily AI Alo — environment template
# Copy to .env and adjust. NEVER commit the real .env.
# ==========================================================================

# ---- App ----
DEBUG=false
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ---- Database (MySQL/MariaDB for production; SQLite supported for dev) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=toor
DB_NAME=ai_news
DATABASE_URL=mysql+pymysql://root:toor@localhost:3306/ai_news?charset=utf8mb4
# Dev SQLite alternative:
# DATABASE_URL=sqlite:///data/db/webcreoling.db
SQL_ECHO=false

# ---- Self-hosted LLM (Ollama / Hugging Face inference server) ----
# All rewriting / agent drafting / embeddings use LOCAL endpoints only.
LLM_ENABLED=true
LLM_PROVIDER=ollama                # ollama | openai_compat | none
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=llama3.2
LLM_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT=60
# Hugging Face TGI / vLLM example:
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://127.0.0.1:8081
# LLM_MODEL=google/flan-t5-base

# ---- Third-party news APIs (multi-source scraper) ----
NEWSAPI_API_KEY=
GUARDIAN_API_KEY=

# ---- External fact-check APIs (dual strategy with cross-source DB check) ----
FACTCHECK_PROVIDER=generic          # snopes | factcheck_org | generic
FACTCHECK_API_URL=
FACTCHECK_API_KEY=
FACTCHECK_TIMEOUT=10

# ---- Approval workflow defaults (runtime-overridable in /agent admin UI) ----
APPROVAL_ESCALATION_HOURS=6         # auto-escalate to next senior role after X hours
APPROVAL_AUTO_APPROVE_HOURS=24      # approval-by-silence threshold when enabled
APPROVAL_AUTO_APPROVE_ENABLED=false

# ---- SMTP mail (approval notifications, ad replies) ----
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=no-reply@daily-ai-alo.com

# ---- Scraper politeness ----
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) WebCreolingNewsBot/1.0
MAX_SCRAPE_RETRIES=3
SCRAPE_RETRY_BACKOFF=2.0
REQUEST_TIMEOUT=20
